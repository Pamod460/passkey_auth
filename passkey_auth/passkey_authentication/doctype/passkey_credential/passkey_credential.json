{
    "name": "Passkey Credential",
    "module": "Passkey Authentication",
    "doctype": "DocType",
    "document_type": "Document",
    "engine": "InnoDB",
    "issingle": 0,
    "istable": 0,
    "is_submittable": 0,
    "autoname": "field:credential_id",
    "title_field": "nickname",
    "search_fields": "nickname,user",
    "description": "Stores WebAuthn/Passkey credential metadata for ERPNext users.",
    "fields": [
        {
            "fieldname": "user",
            "fieldtype": "Link",
            "label": "User",
            "options": "User",
            "reqd": 1,
            "unique": 0,
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "credential_id",
            "fieldtype": "Data",
            "label": "Credential ID",
            "reqd": 1,
            "unique": 1,
            "in_list_view": 1,
            "description": "Base64URL-encoded WebAuthn credential identifier."
        },
        {
            "fieldname": "public_key",
            "fieldtype": "Long Text",
            "label": "Public Key",
            "reqd": 1,
            "description": "Base64URL-encoded COSE public key."
        },
        {
            "fieldname": "user_handle",
            "fieldtype": "Data",
            "label": "WebAuthn User Handle",
            "reqd": 1,
            "unique": 1,
            "description": "Opaque random WebAuthn user handle."
        },
        {
            "fieldname": "sign_count",
            "fieldtype": "Int",
            "label": "Sign Count",
            "default": "0"
        },
        {
            "fieldname": "transports",
            "fieldtype": "Small Text",
            "label": "Transports",
            "description": "JSON array: usb, nfc, ble, internal, hybrid."
        },
        {
            "fieldname": "device_type",
            "fieldtype": "Select",
            "label": "Device Type",
            "options": "\nplatform\ncross-platform",
            "default": "platform",
            "in_list_view": 1
        },
        {
            "fieldname": "backed_up",
            "fieldtype": "Check",
            "label": "Backed Up / Synced",
            "default": "0"
        },
        {
            "fieldname": "backup_eligible",
            "fieldtype": "Check",
            "label": "Backup Eligible",
            "default": "0"
        },
        {
            "fieldname": "authenticator_attachment",
            "fieldtype": "Select",
            "label": "Authenticator Attachment",
            "options": "\nplatform\ncross-platform\nnone"
        },
        {
            "fieldname": "aaguid",
            "fieldtype": "Data",
            "label": "AAGUID"
        },
        {
            "fieldname": "nickname",
            "fieldtype": "Data",
            "label": "Nickname",
            "reqd": 1,
            "in_list_view": 1
        },
        {
            "fieldname": "enabled",
            "fieldtype": "Check",
            "label": "Enabled",
            "default": "1",
            "in_list_view": 1,
            "in_standard_filter": 1
        },
        {
            "fieldname": "revoked",
            "fieldtype": "Check",
            "label": "Revoked",
            "default": "0",
            "in_list_view": 1
        },
        {
            "fieldname": "created_at",
            "fieldtype": "Datetime",
            "label": "Created At",
            "default": "Now",
            "in_list_view": 1
        },
        {
            "fieldname": "last_used_at",
            "fieldtype": "Datetime",
            "label": "Last Used At",
            "in_list_view": 1
        },
        {
            "fieldname": "created_ip",
            "fieldtype": "Data",
            "label": "Created IP"
        },
        {
            "fieldname": "last_used_ip",
            "fieldtype": "Data",
            "label": "Last Used IP"
        },
        {
            "fieldname": "user_agent",
            "fieldtype": "Small Text",
            "label": "User Agent"
        },
        {
            "fieldname": "origin",
            "fieldtype": "Data",
            "label": "Origin"
        },
        {
            "fieldname": "rp_id",
            "fieldtype": "Data",
            "label": "Relying Party ID"
        },
        {
            "fieldname": "user_verified",
            "fieldtype": "Check",
            "label": "User Verified",
            "default": "0"
        },
        {
            "fieldname": "section_authentication",
            "fieldtype": "Section Break",
            "label": "Registration Details"
        },
        {
            "fieldname": "attestation_object",
            "fieldtype": "Long Text",
            "label": "Attestation Object (Base64URL)",
            "hidden": 1
        }
    ],
    "permissions": [
        {
            "role": "System Manager",
            "read": 1,
            "write": 1,
            "create": 1,
            "delete": 1,
            "export": 1,
            "print": 1,
            "email": 1,
            "report": 1
        },
        {
            "role": "All",
            "read": 0,
            "write": 0,
            "create": 0,
            "delete": 0
        }
    ],
    "sort_field": "created_at",
    "sort_order": "DESC"
}
